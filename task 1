import { type ReactNode, useEffect, useMemo, useRef, useState } from 'react';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import { ErrorBoundary } from '@/components/error-boundary';
import { Toaster } from '@/components/ui/toaster';
import { TooltipProvider } from '@/components/ui/tooltip';
import NotFound from '@/pages/not-found';
import { ArrowLeft, ArrowRight, X } from 'lucide-react';
import {
  Route,
  Switch,
  useLocation,
  Router as WouterRouter,
} from 'wouter';

const queryClient = new QueryClient();

function Home() {
  const [activeCategory, setActiveCategory] = useState('All');
  const [activeImageId, setActiveImageId] = useState<string | null>(null);
  const closeButtonRef = useRef<HTMLButtonElement>(null);
  const previousFocusRef = useRef<HTMLElement | null>(null);

  const images: GalleryImage[] = useMemo(
    () => [
      {
        id: 'quiet-tide',
        src: 'https://images.pexels.com/photos/1005417/pexels-photo-1005417.jpeg?auto=compress&cs=tinysrgb&w=1600',
        alt: 'A lone figure walking along a pale beach beneath a wide, overcast sky',
        title: 'The quiet tide',
        category: 'Coast',
      },
      {
        id: 'after-the-rain',
        src: 'https://images.pexels.com/photos/167964/pexels-photo-167964.jpeg?auto=compress&cs=tinysrgb&w=1600',
        alt: 'A winding road disappears into a deep green forest after rain',
        title: 'After the rain',
        category: 'Wilderness',
      },
      {
        id: 'soft-focus',
        src: 'https://images.pexels.com/photos/931177/pexels-photo-931177.jpeg?auto=compress&cs=tinysrgb&w=1600',
        alt: 'A small Parisian street with balconies, old stone facades, and warm evening light',
        title: 'Soft focus',
        category: 'City',
      },
      {
        id: 'blue-hour',
        src: 'https://images.pexels.com/photos/1486974/pexels-photo-1486974.jpeg?auto=compress&cs=tinysrgb&w=1600',
        alt: 'Layered mountain ridges fading into mist at blue hour',
        title: 'Blue hour, somewhere',
        category: 'Wilderness',
      },
      {
        id: 'still-life',
        src: 'https://images.pexels.com/photos/1366919/pexels-photo-1366919.jpeg?auto=compress&cs=tinysrgb&w=1600',
        alt: 'A close portrait of a sunflower opening toward the afternoon sun',
        title: 'A little unhurried',
        category: 'Details',
      },
      {
        id: 'open-water',
        src: 'https://images.pexels.com/photos/457882/pexels-photo-457882.jpeg?auto=compress&cs=tinysrgb&w=1600',
        alt: 'Turquoise water folds into white surf along a rugged shoreline',
        title: 'Open water',
        category: 'Coast',
      },
      {
        id: 'morning-market',
        src: 'https://images.pexels.com/photos/466685/pexels-photo-466685.jpeg?auto=compress&cs=tinysrgb&w=1600',
        alt: 'A quiet city street framed by a row of leafy trees and old buildings',
        title: 'Morning, unplanned',
        category: 'City',
      },
      {
        id: 'wild-light',
        src: 'https://images.pexels.com/photos/1586298/pexels-photo-1586298.jpeg?auto=compress&cs=tinysrgb&w=1600',
        alt: 'Sunlight breaks through tall trees onto a forest path',
        title: 'Where the light lands',
        category: 'Wilderness',
      },
      {
        id: 'petal-study',
        src: 'https://images.pexels.com/photos/1122626/pexels-photo-1122626.jpeg?auto=compress&cs=tinysrgb&w=1600',
        alt: 'A delicate pink flower photographed in close-up against a soft green background',
        title: 'Petal study',
        category: 'Details',
      },
      {
        id: 'last-light',
        src: 'https://images.pexels.com/photos/1430674/pexels-photo-1430674.jpeg?auto=compress&cs=tinysrgb&w=1600',
        alt: 'Soft evening light spills over a tranquil coastline and its rolling surf',
        title: 'Last light',
        category: 'Coast',
      },
    ],
    [],
  );

  const categories = [
    'All',
    ...Array.from(new Set(images.map((image) => image.category))),
  ];
  const visibleImages = images.filter(
    (image) =>
      activeCategory === 'All' || image.category === activeCategory,
  );
  const activeIndex = visibleImages.findIndex(
    (image) => image.id === activeImageId,
  );
  const activeImage = activeIndex >= 0 ? visibleImages[activeIndex] : null;

  const openImage = (image: GalleryImage) => {
    previousFocusRef.current = document.activeElement as HTMLElement;
    setActiveImageId(image.id);
  };

  const closeImage = () => setActiveImageId(null);

  const stepImage = (direction: number) => {
    if (!visibleImages.length) return;
    const index =
      activeIndex < 0
        ? 0
        : (activeIndex + direction + visibleImages.length) %
          visibleImages.length;
    setActiveImageId(visibleImages[index].id);
  };

  useEffect(() => {
    if (!activeImage) {
      previousFocusRef.current?.focus();
      return;
    }

    closeButtonRef.current?.focus();

    const onKeyDown = (event: KeyboardEvent) => {
      if (event.key === 'Escape') {
        event.preventDefault();
        closeImage();
      }
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        stepImage(-1);
      }
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        stepImage(1);
      }
      if (event.key === 'Tab') {
        const controls = document.querySelectorAll<HTMLElement>(
          '.lightbox button',
        );
        const first = controls[0];
        const last = controls[controls.length - 1];

        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    };

    document.addEventListener('keydown', onKeyDown);
    document.body.style.overflow = 'hidden';

    return () => {
      document.removeEventListener('keydown', onKeyDown);
      document.body.style.overflow = '';
    };
  }, [activeImageId, activeImage, activeIndex, visibleImages]);

  return (
    <main className="gallery-shell">
      <header className="topbar">
        <a
          className="brand"
          href="/"
          aria-label="Stillroom home"
          data-testid="link-home"
        >
          <span className="brand-mark" aria-hidden="true">
            s
          </span>
          <span className="brand-name">stillroom</span>
        </a>
        <span className="top-note">A collection for looking closer</span>
      </header>

      <section className="intro" aria-labelledby="gallery-heading">
        <div className="eyebrow">Collected moments · No. 01</div>
        <div className="intro-line">
          <h1 id="gallery-heading">
            A little room
            <br />
            for <em>wonder.</em>
          </h1>
          <p className="intro-copy">
            Photographs that make you pause, gathered from the faraway and the
            almost-ordinary.
          </p>
        </div>
      </section>

      <section aria-label="Photo collection">
        <div className="filter-row">
          <div
            className="filters"
            role="group"
            aria-label="Filter photographs by category"
          >
            {categories.map((category) => (
              <button
                key={category}
                className="filter-button"
                type="button"
                aria-pressed={activeCategory === category}
                onClick={() => setActiveCategory(category)}
                data-testid={`filter-${category.toLowerCase()}`}
              >
                {category}
              </button>
            ))}
          </div>
          <span className="image-count" data-testid="text-image-count">
            {String(visibleImages.length).padStart(2, '0')} photographs
          </span>
        </div>

        <div className="gallery-grid" aria-live="polite" data-testid="gallery-grid">
          {visibleImages.length ? (
            visibleImages.map((image, index) => (
              <button
                key={image.id}
                className="photo-card"
                type="button"
                onClick={() => openImage(image)}
                aria-label={`Open ${image.title}, ${image.category}`}
                data-testid={`photo-${image.id}`}
                style={{ animationDelay: `${index * 45}ms` }}
              >
                <span className="photo-frame">
                  <img
                    src={image.src}
                    alt={image.alt}
                    loading={index > 3 ? 'lazy' : 'eager'}
                    data-testid={`img-${image.id}`}
                  />
                  <span className="photo-open" aria-hidden="true">
                    LOOK CLOSER ↗
                  </span>
                </span>
                <span className="photo-caption">
                  <span className="photo-title">{image.title}</span>
                  <span className="photo-category">{image.category}</span>
                </span>
              </button>
            ))
          ) : (
            <div className="empty-state" data-testid="empty-gallery">
              Nothing here just yet.
            </div>
          )}
        </div>
      </section>

      <footer className="footer-note">
        <span>Made for the in-between moments</span>
        <span>Keep looking · Stay a while</span>
      </footer>

      {activeImage && (
        <div
          className="lightbox"
          role="dialog"
          aria-modal="true"
          aria-label={`Photograph: ${activeImage.title}`}
          onMouseDown={(event) => {
            if (event.target === event.currentTarget) closeImage();
          }}
          data-testid="lightbox"
        >
          <div className="lightbox-controls">
            <span className="lightbox-kicker">
              Stillroom / {activeImage.category}
            </span>
            <button
              ref={closeButtonRef}
              className="icon-control"
              type="button"
              onClick={closeImage}
              aria-label="Close photograph"
              data-testid="button-close-lightbox"
            >
              <X size={20} />
            </button>
          </div>

          <div className="lightbox-image-wrap">
            <img
              className="lightbox-image"
              src={activeImage.src.replace('w=1600', 'w=2200')}
              alt={activeImage.alt}
              data-testid="img-lightbox-active"
            />
          </div>

          <aside className="lightbox-details">
            <div className="lightbox-kicker">A photograph to keep</div>
            <h2 className="lightbox-title">{activeImage.title}</h2>
            <div className="lightbox-category">{activeImage.category}</div>
            <div className="lightbox-count" data-testid="text-lightbox-count">
              {String(activeIndex + 1).padStart(2, '0')} /{' '}
              {String(visibleImages.length).padStart(2, '0')}
            </div>
          </aside>

          <div className="lightbox-nav">
            <button
              className="icon-control"
              type="button"
              onClick={() => stepImage(-1)}
              aria-label="Previous photograph"
              data-testid="button-previous-photo"
            >
              <ArrowLeft size={21} />
            </button>
            <button
              className="icon-control"
              type="button"
              onClick={() => stepImage(1)}
              aria-label="Next photograph"
              data-testid="button-next-photo"
            >
              <ArrowRight size={21} />
            </button>
          </div>
        </div>
      )}
    </main>
  );
}

type GalleryImage = {
  id: string;
  src: string;
  alt: string;
  title: string;
  category: string;
};

function Router() {
  return (
    <RoutedErrorBoundary>
      <Switch>
        <Route path="/" component={Home} />
        <Route component={NotFound} />
      </Switch>
    </RoutedErrorBoundary>
  );
}

function RoutedErrorBoundary({ children }: { children: ReactNode }) {
  const [location] = useLocation();
  return <ErrorBoundary resetKey={location}>{children}</ErrorBoundary>;
}

function App() {
  return (
    <QueryClientProvider client={queryClient}>
      <TooltipProvider>
        <WouterRouter base={import.meta.env.BASE_URL.replace(/\/$/, '')}>
          <Router />
        </WouterRouter>
        <Toaster />
      </TooltipProvider>
    </QueryClientProvider>
  );
}

export default App;
